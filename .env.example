# Arize AX. Leave blank to run untraced.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=software-factory

# The repo the factory works on, and where it keeps its own clone + worktrees.
FACTORY_TARGET_REPO=jimbobbennett/ship-it-card
FACTORY_WORKDIR=work

# Models per station (Claude Code aliases or full model ids).
FACTORY_BUILD_MODEL=sonnet
FACTORY_REVIEW_MODEL=opus

# Optional: for Arize UI deep links on the dashboard (copy from the Arize URL).
ARIZE_ORG_ID=
ARIZE_PROJECT_ID=
GEMINI_API_KEY=            # lets the babysit agent regenerate example cards
